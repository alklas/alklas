#!groovy
// Check devops properties
properties([disableConcurrentBuilds()])

pipeline {
    agent { 
        label 'built-in'
        
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '10'))
        timestamps()
    }
    stages {
        stage("First step") {
            steps {
                sh '''
                ssh student@172.16.7.184 
                echo "Имя удалённого хоста:"
                hostname
                echo "Текущий каталог:"
                pwd
                echo "Имя пользователя:"
                whoami
                '''
            }
        }
        stage("Second step") {
            steps {
                sh 'ssh student@172.16.7.184 \'uptime\''
            }
        }
    }
}
